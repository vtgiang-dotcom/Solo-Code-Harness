# --- Claude Code via FreeModel (Anthropic-compatible gateway) ---
# Copy this file to .env, fill ANTHROPIC_API_KEY, then launch Claude Code with:
#     ./claude-env.ps1            (Windows PowerShell)
#
# Get a key at https://freemodel.dev - one key works with Claude Code.

# Your FreeModel (or any Anthropic-compatible) API key. REQUIRED.
ANTHROPIC_API_KEY=

# Gateway host root. For Claude Code v2.1.x do NOT append /v1/messages here -
# claude-env.ps1 normalizes the URL automatically.
ANTHROPIC_BASE_URL=https://cc.freemodel.dev

# Optional but recommended: reduce non-essential background traffic.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

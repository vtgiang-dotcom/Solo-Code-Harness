{
  "$schema": "https://opencode.ai/config.json",
  "model": "commandcode/deepseek-v4-pro",
  "small_model": "commandcode/gpt-5.4-mini",
  "default_agent": "solo-code-engineer",
  "instructions": [
    "AGENTS.md",
    ".opencode/instruction/*.md"
  ],
  "agent": {
    "solo-code-engineer": {
      "model": "commandcode/deepseek-v4-pro"
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "python .github/scripts/security_scan.py *": "allow",
      "python .github/scripts/checklist.py *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "rm -rf *": "deny",
      "rm -rf /*": "deny",
      "del /s /q *": "deny",
      "DROP TABLE*": "deny",
      "DROP DATABASE*": "deny"
    },
    "external_directory": "ask"
  }
}

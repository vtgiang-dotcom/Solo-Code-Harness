# Solo-Code environment template
# Copy to .env and fill in your keys. .env is gitignored.
#
# CommandCode — single API key for Claude, GPT, Gemini, DeepSeek, Qwen, etc.
# Get key at https://commandcode.ai
#
COMMANDCODE_BASE_URL=https://api.commandcode.ai/v1
COMMANDCODE_API_KEY=your-commandcode-key-here
#
# DeepSeek — direct API access to DeepSeek models
# Get key at https://platform.deepseek.com
#
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
#
# ─── Claude Code via FreeModel (Anthropic-compatible gateway) ───────────────
# Get key at https://freemodel.dev/dashboard — one key works with Claude Code.
# Launch with: ./claude-env.ps1   (loads this .env, normalizes URL)
# 
# Uncomment the tier your API key belongs to (Claude Code appends /v1/messages).
#   Standard : https://cc.freemodel.dev
#   Mid-tier : https://api-cc.freemodel.dev
#   Top-tier : https://cc-t2.freemodel.dev
#
ANTHROPIC_API_KEY=your-freemodel-key-here
ANTHROPIC_BASE_URL=https://cc.freemodel.dev
# ANTHROPIC_BASE_URL=https://api-cc.freemodel.dev
# ANTHROPIC_BASE_URL=https://cc-t2.freemodel.dev
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

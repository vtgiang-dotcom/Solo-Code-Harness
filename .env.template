# Solo-Code environment template
# Copy to .env and fill in your keys. .env is gitignored.
#
# CommandCode — single API key for Claude, GPT, Gemini, DeepSeek, Qwen, etc.
# Get key at https://commandcode.ai
#
COMMANDCODE_BASE_URL=https://api.commandcode.ai/v1
COMMANDCODE_API_KEY=your-commandcode-key-here
#
# DeepSeek — direct API access to DeepSeek models
# Get key at https://platform.deepseek.com
#
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
#
# ─── jcode OpenAI-compatible workers (FreeModel) ─────────────────────────
# FreeModel /v1/models catalog: gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna.
# jcode.ps1 uses Chat Completions via a custom openai-compatible profile.
# Store the host root only — do NOT append /v1/chat/completions or /v1/responses.
#   api.freemodel.dev     — verified 2026-08-07 (Chat + Responses), default
#   work.freemodel.dev    — verified 2026-08-07 (/v1/models ok, smoke pending)
#   api-t2-sg.freemodel.dev — 3-model catalog, account-tier restricted
OPENAI_API_KEY=your-freemodel-key-here
OPENAI_BASE_URL=https://api.freemodel.dev
# OPENAI_BASE_URL=https://work.freemodel.dev
# OPENAI_BASE_URL=https://api-t2-sg.freemodel.dev
#
# ─── Claude Code via FreeModel (Anthropic-compatible gateway) ───────────────
# Same API key works for both Anthropic and OpenAI-compatible endpoints.
# Launch with: ./claude-env.ps1   (default profile: gateway)
# Other profiles: ./claude-env.ps1 --profile native | --profile kilo
# 
# Uncomment the tier your API key belongs to (Claude Code appends /v1/messages).
# gateway profile uses --bare for third-party auth; native/kilo run full mode.
#   Standard : https://cc.freemodel.dev
#   Mid-tier : https://api-cc.freemodel.dev
#   Top-tier : https://cc-t2.freemodel.dev
#
ANTHROPIC_API_KEY=your-freemodel-key-here
ANTHROPIC_BASE_URL=https://cc.freemodel.dev
# ANTHROPIC_BASE_URL=https://api-cc.freemodel.dev
# ANTHROPIC_BASE_URL=https://cc-t2.freemodel.dev
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

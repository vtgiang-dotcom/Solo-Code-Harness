{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".kilo/instruction/harness-boundaries.md",
    ".kilo/instruction/security-patterns.md",
    ".kilo/instruction/custom-framework-rules.md",
    ".kilo/instruction/harness-checklist.md",
    ".kilo/instruction/rules-database.md",
    ".kilo/instruction/rules-git.md",
    ".kilo/instruction/rules-python.md",
    ".kilo/instruction/rules-typescript.md",
    ".kilo/hooks/README.md"
  ],
  "permission": {
    "bash": {
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf /": "deny",
      "rm -rf *": "deny",
      "rm -rf ./*": "deny",
      "rm --no-preserve-root *": "deny",
      "rm -r *": "deny",
      "rm -r -f *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push * +*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git reset --hard*": "deny",
      "git reset --mixed*": "deny",
      "git reset --soft*": "deny",
      "git clean -fd*": "deny",
      "git clean -fx*": "deny",
      "git clean -f *": "deny",
      "git branch -D*": "deny",
      "git branch --delete --force*": "deny",
      "git rebase*": "deny",
      "git filter-branch*": "deny",
      "git update-ref*": "deny",
      "git stash drop*": "deny",
      "git reflog delete*": "deny",
      "git gc*": "deny",
      "mkfs.*": "deny",
      "dd if=*": "deny",
      "format*": "deny",
      "shred*": "deny",
      "*DROP TABLE*": "deny",
      "*drop table*": "deny",
      "*TRUNCATE TABLE*": "deny",
      "*truncate table*": "deny",
      "*DROP DATABASE*": "deny",
      "*drop database*": "deny",
      "Remove-Item*": "deny",
      "rmdir*": "deny",
      "rd /s*": "deny",
      "del /f*": "deny",
      "del /q*": "deny",
      "del /s*": "deny",
      "Format-Volume*": "deny",
      "Stop-Computer*": "deny",
      "Restart-Computer*": "deny",
      "diskpart*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "npm*": "allow",
      "node*": "allow",
      "python*": "allow",
      "npx*": "allow",
      "bun*": "allow",
      "git*": "allow",
      "gh*": "allow",
      "ls*": "allow",
      "cd*": "allow",
      "mkdir*": "allow",
      "cp*": "allow",
      "mv*": "allow",
      "cat*": "allow",
      "echo*": "allow",
      "find*": "allow",
      "wc*": "allow",
      "head*": "allow",
      "tail*": "allow"
    }
  },
  "agent": {
    "orchestrator": {
      "permission": {
        "task": {
          "*": "deny",
          "solo-code-engineer": "allow",
          "code-reviewer": "allow",
          "security-auditor": "allow",
          "planner": "allow",
          "tdd-guide": "allow",
          "python-reviewer": "allow",
          "typescript-reviewer": "allow",
          "database-reviewer": "allow",
          "architect": "allow",
          "code-architect": "allow",
          "code-explorer": "allow",
          "refactor-cleaner": "allow"
        }
      }
    }
  }
}
